<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- EŞİTLEME İÇİN DEPOLAMA İZNİ
         Eşitleme dosyası Documents/HastaKayit/sync altına yazılır
         (Capacitor'ın Directory.Documents'i Android'de gerçek, herkese açık
         /storage/emulated/0/Documents klasörüdür). Oraya yazmamızın sebebi
         Syncthing'in o klasörü görebilmesi: uygulamanın kendi kabı
         (Android/data/com.hastakayit.app) Android 11'den beri BAŞKA
         uygulamalara kapalıdır, dolayısıyla Syncthing oradan okuyamaz.

         Android 10 ve öncesi: WRITE_EXTERNAL_STORAGE yeter.
         Android 11 ve sonrası (Samsung'ların hepsi): kapsamlı depolama
         yüzünden klasik dosya yazma engellenir; "tüm dosyalara erişim"
         (MANAGE_EXTERNAL_STORAGE) gerekir. Kullanıcı bunu bir kez
         Ayarlar > Uygulamalar > Hasta Kayıt > İzinler üzerinden verir.
         Uygulama mağazaya değil elden (APK) kurulduğu için bu izin
         kullanılabilir; Play Store'da ayrı gerekçe istenir. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Randevu hatırlatmaları (Android 13+ bildirim izni ister). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
